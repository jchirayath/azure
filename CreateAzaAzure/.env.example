# =============================================================================
# CreateAzaAzure — SECRETS  (copy to .env, fill in, never commit)
# =============================================================================
# .env is gitignored. Anything that is a credential, an email tied to you, or a
# value you would not want in a public repo belongs HERE, not in config.sh.
#
#   cp .env.example .env && $EDITOR .env
# -----------------------------------------------------------------------------

# Email used by Certbot / Let's Encrypt registration and by the mail module.
CERTBOT_EMAIL="you@example.com"
MAIL_USER="you@example.com"

# OPTIONAL — pre-set service passwords. If left blank, deploy.sh generates
# strong random values and stores them in Key Vault automatically.
# Provide a value here only if you must reuse a known credential.
MYSQL_ROOT_PASSWORD=""
GUAC_DB_PASSWORD=""
SPLUNK_ADMIN_PASSWORD=""

# OPTIONAL — external Guacamole MySQL (only if you set GUAC_USE_LOCAL_MYSQL=false
# in config.sh and want to point at a remote DB instead of the local one).
GUAC_SQL_HOST=""
GUAC_SQL_USER=""
GUAC_SQL_PASS=""
